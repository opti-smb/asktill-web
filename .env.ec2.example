# Example EC2 production env (asktill.com). Copy to .env.ec2 locally — never commit secrets.
# Build: npm run build:ec2
#
# Keep Vercel on default `npm run build` (.env.production) so origins do not mix.
# In Clerk Dashboard → Domains / Paths: allow BOTH
#   https://asktill.com
#   https://www.asktill.com
#   https://asktill-web-three.vercel.app  (and any other Vercel preview hosts)

VITE_APP_ORIGIN=https://asktill.com
VITE_PUBLIC_SITE=ec2
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Same API URLs as production / Render proxies as needed:
# VITE_API_BASE_URL=
# VITE_AUTH_API_URL=
# VITE_REGISTER_API_URL=
# VITE_SUBSCRIPTION_API_URL=
# VITE_AGENTS_API_URL=
