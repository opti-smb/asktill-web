# Example EC2 production env (asktill.com). Copy to .env.ec2 locally — never commit secrets.
# Build: npm run build:ec2
#
# EC2 APIs only. Do not point these at Render/Vercel.
VITE_APP_ORIGIN=https://asktill.com
VITE_PUBLIC_SITE=ec2
VITE_API_BASE_URL=https://asktill.com
VITE_AUTH_API_URL=https://asktill.com/svc/auth
VITE_REGISTER_API_URL=https://asktill.com/svc/register
VITE_SUBSCRIPTION_API_URL=https://asktill.com/svc/subscription
VITE_AGENTS_API_URL=https://asktill.com/svc/agents
VITE_ENTITLEMENTS_API_URL=https://asktill.com/svc/entitlements
# EC2 / asktill.com must use Production Clerk (pk_live_...).
# Local + Vercel use Development (pk_test_...) — do not mix.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
