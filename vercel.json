{
  "rewrites": [
    {
      "source": "/auth-api/:path*",
      "destination": "https://authentication-service-s3tl.onrender.com/:path*"
    },
    {
      "source": "/api/plaid-health",
      "destination": "https://asktill-plaid.onrender.com/health"
    },
    {
      "source": "/api/plaid-parser-health",
      "destination": "https://asktill-plaid-parser.onrender.com/health"
    },
    {
      "source": "/api/plaid/:path*",
      "destination": "https://asktill-plaid.onrender.com/api/plaid/:path*"
    },
    {
      "source": "/api/chargebacks-health",
      "destination": "https://asktill-chargebacks.onrender.com/health"
    },
    {
      "source": "/integrations/stripe",
      "destination": "https://asktill-chargebacks.onrender.com/integrations/stripe"
    },
    {
      "source": "/integrations/stripe/:path*",
      "destination": "https://asktill-chargebacks.onrender.com/integrations/stripe/:path*"
    },
    {
      "source": "/integrations/shopify",
      "destination": "https://asktill-chargebacks.onrender.com/integrations/shopify"
    },
    {
      "source": "/integrations/shopify/:path*",
      "destination": "https://asktill-chargebacks.onrender.com/integrations/shopify/:path*"
    },
    {
      "source": "/api/cb4",
      "destination": "https://asktill-chargebacks.onrender.com/api/cb4"
    },
    {
      "source": "/api/cb4/:path*",
      "destination": "https://asktill-chargebacks.onrender.com/api/cb4/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Asktill-Build",
          "value": "2026-09-03-cb4"
        }
      ]
    }
  ]
}
