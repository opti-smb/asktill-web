{
  "rewrites": [
    {
      "source": "/auth-api/:path*",
      "destination": "https://authentication-service-s3tl.onrender.com/:path*"
    },
    {
      "source": "/api/plaid/:path*",
      "destination": "https://asktill-plaid.onrender.com/api/plaid/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Asktill-Build",
          "value": "2026-07-31-marketing-landing"
        }
      ]
    }
  ]
}
