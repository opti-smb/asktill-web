# AskTill local ports (do NOT put asktill-landing on these)
# 5173 = asktill-web (main app)
# 5174 = Admin Dashboard
# 8000 = backend
# 8001 = Agents Service (AT Help)
# 8002 = Auth
# 8003 = Register
# 8004 = Entitlements
# 8005 = Subscription
# Landing (asktill-landing) is separate — use 5180+ later, never 5173/5174.
#
# IMPORTANT: These localhost values are for LOCAL DEV only.
# Never set them on Vercel. Production builds reject localhost and use
# known Render/Vercel URLs from src/lib/publicUrls.ts.

VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_API_URL=http://localhost:8002
VITE_REGISTER_API_URL=http://localhost:8003
VITE_SUBSCRIPTION_API_URL=http://localhost:8005
VITE_ENTITLEMENTS_API_URL=http://localhost:8004
VITE_AGENTS_API_URL=http://127.0.0.1:8001
VITE_ADMIN_DASHBOARD_URL=http://127.0.0.1:5174
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
TOKEN_STORAGE_KEY=asktill_access_token
VITE_APP_ORIGIN=http://localhost:5173
# Stripe — publishable key only (test mode); secret key stays on Subscription service
VITE_STRIPE_PUBLISHABLE_KEY=
